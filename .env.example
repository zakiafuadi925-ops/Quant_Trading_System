# ============================================
# Quant Trading System v7.0.0 - Environment Variables
# Copy to .env and fill in your own values
# ============================================

# ---- MongoDB ----
MONGO_USER=quantadmin
MONGO_PASSWORD=quantpass2024
MONGO_DB=quant_trading
MONGO_PORT=27017

# ---- Application ----
APP_PORT=3002
NODE_ENV=production
JWT_SECRET=your-jwt-secret-min-32-chars-here!!
AES_VAULT_KEY=your-aes-key-must-be-32-chars-xx

# ---- ML Service ----
ML_PORT=8000
ML_SERVICE_URL=http://ml-service:8000

# ---- Crypto API ----
CRYPTO_API_BASE_URL=https://api.coingecko.com/api/v3
CRYPTO_API_KEY=

# ---- Notifications (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- Development ----
DISABLE_HMR=false
