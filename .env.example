# .env.example – copy to .env and fill in your own values

# Base URL for the crypto market data API (e.g., CoinGecko, Binance, etc.)
CRYPTO_API_BASE_URL=https://api.example.com

# API key / token for the chosen provider (replace with your real key)
CRYPTO_API_KEY=YOUR_API_KEY_HERE

# Disable Vite Hot Module Replacement (useful for CI or low‑resource envs)
DISABLE_HMR=false

