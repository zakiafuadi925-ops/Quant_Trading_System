# Dedicated Python FastAPI ML Inference Microservice
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Python requirements
COPY requirements-inference.txt /app/
RUN pip install --no-cache-dir -r requirements-inference.txt

# Copy inference service and model assets
COPY inference_service.py /app/
COPY models/ /app/models/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "inference_service:app", "--host", "0.0.0.0", "--port", "8000"]
